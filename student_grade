# grade_calculator.py

def calculate_average(m1, m2, m3):
    """Validate marks (0-100) for three subjects and return the rounded average."""
    for mark in (m1, m2, m3):
        if mark < 0 or mark > 100:
            raise ValueError("Subject marks must be between 0 and 100.")
    return round((m1 + m2 + m3) / 3, 2)


def assign_grade(average):
    """Return the letter grade based on the average score criteria."""
    if average < 0 or average > 100:
        raise ValueError("Average score must be between 0 and 100.")
    if average >= 90:
        return "Grade S"
    elif average >= 80:
        return "Grade A"
    elif average >= 65:
        return "Grade B"
    elif average >= 50:
        return "Grade C"
    elif average >= 40:
        return "Grade D"
    else:
        return "Grade F"


def get_student_report(name, department, semester, marks):
    """Accept student details and three subject marks, returning a complete evaluation dictionary."""
    if not name or not str(name).strip():
        raise ValueError("Student name cannot be empty.")
    if not department or not str(department).strip():
        raise ValueError("Department cannot be empty.")
    if len(marks) != 3:
        raise ValueError("Exactly three subject marks are required.")

    avg = calculate_average(marks[0], marks[1], marks[2])
    grade = assign_grade(avg)
    return {
        "name": name.strip(),
        "department": department.strip(),
        "semester": semester,
        "marks": list(marks),
        "average": avg,
        "grade": grade,
        "status": "Pass" if all(m >= 40 for m in marks) and avg >= 40 else "Fail"
    }


if __name__ == "__main__":
    report = get_student_report("Rayyan", "BCA", 3, [85, 92, 78])
    print(report)
